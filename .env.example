# Salin file ini menjadi .env.local lalu isi dari
# Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) atau legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Kunci enkripsi API key AI (32 byte base64). Buat dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_ENCRYPTION_KEY=

# OPSIONAL — untuk tombol "Tambah Akun" di Pengaturan → Pengguna & Akses.
# Supabase → Project Settings → API Keys → Secret keys (sb_secret_...).
# Hanya dibaca server; JANGAN beri awalan NEXT_PUBLIC_ dan jangan pernah di-commit.
SUPABASE_SECRET_KEY=
